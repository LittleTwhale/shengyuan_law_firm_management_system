# ============================================================
# 腾讯云 COS 配置（仅在 STORAGE_TYPE=COS 时必需）
# 请从腾讯云控制台获取以下信息：
#   API密钥管理 → https://console.cloud.tencent.com/cam/capi
#   对象存储   → https://console.cloud.tencent.com/cos/bucket
# ============================================================

# 切换为 COS 模式
STORAGE_TYPE=COS

# 腾讯云 CAM 密钥（子账号建议仅授予 COS 全读写权限）
COS_SECRET_ID=AKIDxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
COS_SECRET_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# COS 存储桶信息
COS_BUCKET=your-bucket-name-1250000000
COS_REGION=ap-guangzhou

# （可选）用于前端直传临时密钥的角色 ARN
# 新建角色 → 角色名 → 获取 ARN：qcs::cam::uin/{主账号ID}:roleName/{角色名}
COS_STS_ROLE_ARN=
